@model double
@* Percent complete (0–100). ViewData["Failed"] = true renders it red. *@
@{
    var pct = Math.Clamp(Model, 0, 100);
    var css = ViewData["Failed"] is true ? "bg-danger" : pct >= 100 ? "bg-success" : "";
}
<div class="progress" role="progressbar" aria-valuenow="@pct.ToString("0.#")" aria-valuemin="0" aria-valuemax="100" style="min-width: 6rem">
    <div class="progress-bar @css" style="width: @pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">@pct.ToString("0.#")%</div>
</div>
