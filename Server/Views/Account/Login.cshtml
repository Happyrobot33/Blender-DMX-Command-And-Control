@{
    ViewData["Title"] = "Sign in";
}
<div class="row justify-content-center">
    <div class="col-sm-8 col-md-6 col-lg-4">
        <h1 class="h3 mb-3">Sign in</h1>
        @if (ViewData["Error"] is string error)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input id="username" name="username" class="form-control" value="@ViewData["Username"]"
                       autocomplete="username" autofocus required maxlength="64" />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input id="password" name="password" type="password" class="form-control"
                       autocomplete="current-password" required maxlength="256" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>
    </div>
</div>
