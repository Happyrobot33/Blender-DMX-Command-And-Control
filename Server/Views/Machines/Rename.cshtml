@model Server.Data.Entities.RenderMachine
@{
    ViewData["Title"] = $"Rename {Model.Name}";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Render machines</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>
<h1 class="h3">Rename @Model.Name</h1>
@if (ViewData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<form method="post" asp-action="Rename" asp-route-id="@Model.Id" class="col-md-6">
    <div class="mb-3">
        <label for="name" class="form-label">Name</label>
        <input id="name" name="name" class="form-control" value="@(ViewData["Name"] ?? Model.Name)" required
               maxlength="@Server.Auth.RenderMachineService.MaxNameLength" autocomplete="off" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
