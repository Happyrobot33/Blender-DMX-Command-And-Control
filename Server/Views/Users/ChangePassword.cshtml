@model Server.Data.Entities.User
@{
    ViewData["Title"] = $"Change password: {Model.Username}";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Username</li>
    </ol>
</nav>
<h1 class="h3">Change password for @Model.Username</h1>
<p class="text-muted">All of this user's other sessions will be signed out.</p>
@if (ViewData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<form method="post" asp-action="ChangePassword" asp-route-id="@Model.Id" class="col-md-6">
    <partial name="_PasswordFields" />
    <button type="submit" class="btn btn-primary">Change password</button>
</form>
