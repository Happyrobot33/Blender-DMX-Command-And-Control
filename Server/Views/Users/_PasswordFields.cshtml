<div class="mb-3">
    <label for="password" class="form-label">Password</label>
    <input id="password" name="password" type="password" class="form-control" required
           minlength="@Server.Auth.UserService.MinPasswordLength" maxlength="@Server.Auth.UserService.MaxPasswordLength" autocomplete="new-password" />
    <div class="form-text">At least @Server.Auth.UserService.MinPasswordLength characters.</div>
</div>
<div class="mb-3">
    <label for="confirmPassword" class="form-label">Confirm password</label>
    <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" required
           maxlength="@Server.Auth.UserService.MaxPasswordLength" autocomplete="new-password" />
</div>
